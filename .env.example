# Public host served by Caddy. Use localhost for local Docker Compose.
APP_DOMAIN=localhost
# Absolute HTTPS URL used in Digest links and pause notices.
APP_URL=https://localhost

# PostgreSQL. Compose uses POSTGRES_PASSWORD to build its internal DATABASE_URL.
# Change the password before exposing an instance to the internet.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Direct runs outside Docker Compose use this URL; the Compose services use database:5432.
DATABASE_URL=postgres://restar:change-me@localhost:5432/restar

# GitHub OAuth App credentials. Callback URL:
# https://APP_DOMAIN/api/auth/github/callback
# ReStar requests user:email only; it imports public Stars and never asks for repo scope.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base64-encoded 32-byte AES key. Keep stable for the life of the database.
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
# Separate secret used to sign short-lived Digest email action links.
# Generate with: openssl rand -base64 32
EMAIL_ACTION_TOKEN_SECRET=

# Email delivery. EMAIL_FROM is required for both providers.
EMAIL_PROVIDER=resend
EMAIL_FROM=
# Resend configuration (when EMAIL_PROVIDER=resend).
RESEND_API_KEY=
# SMTP configuration (when EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
