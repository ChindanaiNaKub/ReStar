# Public address served by Caddy. Use localhost for local Docker Compose.
APP_DOMAIN=localhost

# Change before exposing an instance to the internet.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Direct runs outside Docker Compose use this URL.
DATABASE_URL=postgres://restar:change-me@localhost:5432/restar

# GitHub OAuth App credentials. The callback URL is https://APP_DOMAIN/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base64-encoded 32-byte AES key, for example: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# Email delivery. Set EMAIL_PROVIDER to resend or smtp.
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
